
import random
from datetime import datetime
from typing import Dict, Type

class BaseAgent(mesa.Agent):
    """15 özellikli temel ajan sınıfı"""
    def __init__(self, model):
        super().__init__(model)
        
        # 15 Temel Özellik
        self.created_at = datetime.now()  # 1. Oluşturulma zamanı
        self.is_active = True            # 2. Aktif/pasif durumu
        self.energy = 100                # 3. Enerji seviyesi
        self.age = 0                     # 4. Yaş (adım sayacı)
        self.speed = random.uniform(0.5, 2.0)  # 5. Hareket hızı
        self.color = "#" + "".join(random.choices("0123456789ABCDEF", k=6))  # 6. Rastgele renk
        self.memory = []                 # 7. Bellek listesi
        self.social_status = random.choice(["low", "medium", "high"])  # 8. Sosyal statü
        self.health = 100                # 9. Sağlık puanı
        self.stress_level = 0            # 10. Stres seviyesi
        self.knowledge = random.randint(1, 100)  # 11. Bilgi düzeyi
        self.productivity = 80           # 12. Verimlilik
        self.location = (0, 0)           # 13. Konum bilgisi
        self.wealth = random.randint(10, 1000)  # 14. Servet
        self.reputation = 50             # 15. İtibar puanı
    
    def update_age(self):
        """Her adımda yaşı artır"""
        self.age += 1
    
    def log(self, message):
        print(f"[{self.__class__.__name__} {self.unique_id}] {message}")

# 10 Özel Ajan Sınıfı (Her birinde 5 ek özellik)
class Worker(BaseAgent):
    def __init__(self, model):
        super().__init__(model)
        # 5 Ek Özellik
        self.skill = random.choice(["carpenter", "engineer", "designer"])  # 1
        self.salary = random.randint(3000, 10000)                          # 2
        self.union_member = random.choice([True, False])                   # 3
        self.work_experience = random.randint(1, 20)                       # 4
        self.tools = ["laptop", "notebook"]                                # 5
    
    def step(self):
        self.productivity -= random.randint(1, 10)
        self.log(f"Çalışıyor (Verimlilik: {self.productivity})")

