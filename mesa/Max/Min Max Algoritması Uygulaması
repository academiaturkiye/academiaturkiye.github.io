# Örnek veri oluştur (rastgele fiyat hareketleri)
np.random.seed(42)
n_days = 200
S = 100 + np.cumsum(np.random.randn(n_days) * 2)

# Stratejiyi çalıştır
wealth, assets = run_max_min_strategy(S, r=0.05, delta_tp=10, t_predict=150)

# Sonuçları görselleştir
plt.figure(figsize=(12, 6))
plt.subplot(2, 1, 1)
plt.plot(S, label='Varlık Fiyatı', color='blue')
plt.title('Max/Min Algoritması Performansı')
plt.legend()

plt.subplot(2, 1, 2)
plt.plot(wealth, label='Servet', color='green')
plt.plot(assets * S, label='Varlık Değeri', linestyle='--', color='red')
plt.legend()
plt.show()

print(f"Başlangıç Serveti: {wealth[0]:.2f}, Son Servet: {wealth[-1]:.2f}")
