# SimulationModel örneği oluştur
mod = SimulationModel(5, 5, 5, 5, 5, 5, 5, 4, 4, 4)

# Tüm ajanların piyasa analizini çalıştır ve sonuçları yazdır
for agent in mod.agents:
    analiz = agent.analyze_market()
    print(f"Ajan ID: {agent.unique_id} | Geçmiş Veri Penceresi: {agent.gecmis_veri_penceresi} | Sonuç: {analiz}")
