import numpy as np
import pandas as pd
from mesa import Agent, Model
from mesa.time import RandomActivation
from mesa.datacollection import DataCollector

class TradingAgent(Agent):
    """Bir ortalamaya geri dönüş stratejisi uygulayan tüccar ajanı."""
    def __init__(self, unique_id, model, window_size=20, threshold=1.5):
        super().__init__(unique_id, model)
        self.window_size = window_size  # Ortalama hesaplama penceresi
        self.threshold = threshold    # İşlem tetikleme eşiği
        self.position = 0             # Mevcut pozisyon (0: yok, 1: long, -1: short)
        self.cash = 10000             # Başlangıç nakit miktarı
        self.portfolio_value = 10000  # Portföy değeri
        self.trades = []              # Ticaret geçmişi

    def calculate_sma(self):
        """Basit hareketli ortalama hesaplar."""
        if len(self.model.price_history) >= self.window_size:
            return np.mean(self.model.price_history[-self.window_size:])
        return None

    def calculate_z_score(self):
        """Fiyatın ortalamadan kaç standart sapma uzakta olduğunu hesaplar."""
        if len(self.model.price_history) >= self.window_size:
            recent_prices = self.model.price_history[-self.window_size:]
            sma = np.mean(recent_prices)
            std = np.std(recent_prices)
            if std > 0:
                return (self.model.current_price - sma) / std
        return None

    def step(self):
        # Güncel fiyatı al
        current_price = self.model.current_price
        
        # Z-skorunu hesapla
        z_score = self.calculate_z_score()
        
        if z_score is not None:
            # Alım/satım kararı ver
            if z_score < -self.threshold and self.position <= 0:
                # Uzun pozisyon al (al)
                shares_to_buy = int(self.cash / current_price)
                if shares_to_buy > 0:
                    self.position = 1
                    self.cash -= shares_to_buy * current_price
                    self.trades.append(('buy', current_price, self.model.time))
                    
            elif z_score > self.threshold and self.position >= 0:
                # Kısa pozisyon al (sat)
                if self.position == 1:
                    # Uzun pozisyonu kapat
                    self.cash += self.position * current_price
                    self.trades.append(('sell', current_price, self.model.time))
                self.position = -1
                
            elif abs(z_score) < 0.5 and self.position != 0:
                # Pozisyonu kapat
                self.cash += self.position * current_price
                self.trades.append(('close', current_price, self.model.time))
                self.position = 0
        
        # Portföy değerini güncelle
        self.portfolio_value = self.cash + self.position * current_price


class MeanReversionModel(Model):
    """Ortalamaya geri dönüş piyasa modeli."""
    def __init__(self, N, price_series):
        self.num_agents = N
        self.price_history = price_series[:20].tolist()  # Başlangıç fiyat geçmişi
        self.current_price = price_series[20]
        self.time = 20
        self.price_series = price_series
        self.schedule = RandomActivation(self)
        
        # Ajanları oluştur
        for i in range(self.num_agents):
            # Her ajan farklı parametrelerle oluşturulabilir
            window_size = np.random.randint(10, 50)
            threshold = np.random.uniform(1.0, 2.0)
            agent = TradingAgent(i, self, window_size, threshold)
            self.schedule.add(agent)
        
        # Veri toplayıcı
        self.datacollector = DataCollector(
            agent_reporters={"Portfolio": "portfolio_value", "Position": "position"}
        )

    def step(self):
        # Fiyatı güncelle
        self.time += 1
        if self.time < len(self.price_series):
            self.current_price = self.price_series[self.time]
            self.price_history.append(self.current_price)
            
            # Ajanları güncelle
            self.schedule.step()
            
            # Veri topla
            self.datacollector.collect(self)
        else:
            self.running = False


# Örnek fiyat verisi oluştur (gerçek veriyle değiştirilebilir)
np.random.seed(42)
n_periods = 200
base_price = 100
random_walk = np.cumsum(np.random.normal(0, 1, n_periods))
price_series = base_price + random_walk

# Modeli oluştur ve çalıştır
model = MeanReversionModel(50, price_series)
for _ in range(n_periods - 21):
    model.step()

# Sonuçları topla
agent_data = model.datacollector.get_agent_vars_dataframe()
agent_data = agent_data.reset_index()

# Portföy performansını analiz et
final_portfolios = agent_data[agent_data.Step == agent_data.Step.max()]
print("Portföy Performans Özeti:")
print(final_portfolios.groupby('Position').Portfolio.describe())

# Grafik çiz
import matplotlib.pyplot as plt

plt.figure(figsize=(12, 6))
plt.plot(model.price_history, label='Fiyat')
plt.title('Ortalamaya Geri Dönüş Stratejisi Simülasyonu')
plt.xlabel('Zaman')
plt.ylabel('Fiyat')
plt.legend()
plt.show()
