class TraderAgent(mesa.Agent):
    def __init__(self, unique_id, model):
        super().__init__(unique_id, model)
        self.alis_fiyati = np.random.normal(100, 2)
        self.alis_miktari = np.random.randint(1, 10)
        self.satis_fiyati = np.random.normal(105, 2)
        self.satis_miktari = np.random.randint(1, 10)

