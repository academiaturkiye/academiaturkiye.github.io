1. Veri Toplama ve Ön İşleme


import numpy as np
import matplotlib.pyplot as plt
from scipy.stats import pearsonr
from sklearn.metrics import mean_squared_error

# Ajan emirlerini topla
def collect_orders(agent_list):
    buys = []; sells = []
    for agent in agent_list:
        if hasattr(agent, 'alis_fiyati') and hasattr(agent, 'alis_miktari'):
            buys.extend([agent.alis_fiyati]*int(agent.alis_miktari))
        if hasattr(agent, 'satis_fiyati') and hasattr(agent, 'satis_miktari'):
            sells.extend([agent.satis_fiyati]*int(agent.satis_miktari))
    return np.array(buys), np.array(sells)



2. Görselleştirme ve Şekil Analizi



def analyze_orderbook_shape(buy_prices, sell_prices, mid_price):
    plt.figure(figsize=(12,6))
    
    # Histogram ayarları
    bins = np.linspace(min(buy_prices.min(), sell_prices.min()), 
                     max(buy_prices.max(), sell_prices.max()), 50)
    
    # Alım emirleri
    plt.hist(buy_prices, bins=bins, alpha=0.7, color='green', label='Alım', density=True)
    
    # Satım emirleri
    plt.hist(sell_prices, bins=bins, alpha=0.7, color='red', label='Satım', density=True)
    
    plt.axvline(mid_price, color='black', linestyle='--', label='Piyasa Fiyatı')
    plt.title('Emir Defteri Dağılımı')
    plt.xlabel('Fiyat')
    plt.ylabel('Yoğunluk')
    plt.legend()
    plt.grid(True)
    
    # Şekil benzerliği analizi
    buy_hist, _ = np.histogram(buy_prices, bins=bins, density=True)
    sell_hist, _ = np.histogram(sell_prices, bins=bins, density=True)
    
    # L-shape testi (Piyasa fiyatına yakın yoğunluk)
    l_shape_score = pearsonr(buy_hist[:len(buy_hist)//2], 
                           sell_hist[:len(sell_hist)//2])[0]
    
    # U-shape testi (Piyasa fiyatından uzak yoğunluk)
    u_shape_score = 1 - mean_squared_error(buy_hist[len(buy_hist)//4:3*len(buy_hist)//4], 
                                         sell_hist[len(sell_hist)//4:3*len(sell_hist)//4])
    
    print(f"L-shape Benzerlik Skoru: {l_shape_score:.2f} (1'e yakın=L-shape)")
    print(f"U-shape Benzerlik Skoru: {u_shape_score:.2f} (1'e yakın=U-shape)")
    
    plt.show()


3. Mesa ile Entegrasyon


class MarketModel(mesa.Model):
    def __init__(self, N):
        self.schedule = mesa.time.RandomActivation(self)
        self.agents = [TraderAgent(i, self) for i in range(N)]
        
    def step(self):
        self.schedule.step()
        
        # Her 10 adımda bir analiz yap
        if self.schedule.steps % 10 == 0:
            buy_prices, sell_prices = collect_orders(self.agents)
            mid_price = np.mean([*buy_prices, *sell_prices])
            analyze_orderbook_shape(buy_prices, sell_prices, mid_price)


