

# AJANLARIN GEÇMİŞ VERİ PENCERESİNE PİYASA ANALİZ SONUÇLARINI GÖRMEK İSTERSEK:

YÖNTEM 1: 

# SimulationModel örneği oluştur
mod = SimulationModel(5, 5, 5, 5, 5, 5, 5, 4, 4, 4)
mod.seriyi_goster()
# Tüm ajanların piyasa analizini çalıştır ve sonuçları yazdır
for agent in mod.agents:
    analiz = agent.analyze_market()
    print(f"Ajan ID: {agent.unique_id} | Geçmiş Veri Penceresi: {agent.gecmis_veri_penceresi} | Sonuç: {analiz}")


YÖNTEM 2:

mod = SimulationModel(5, 5, 5, 5, 5, 5, 5, 4, 4, 4)
# Get an agent, for example, agent with unique_id 1
agent = mod.find_agent(30)  

# Call analyze_market on the agent
if agent:  # Check if agent was found
    analiz = agent.analyze_market()
    print(analiz)

YÖNTEM 3:

# Eğer find_agent ile belirli bir ajanı seçmek isterseniz:

# Belirli bir ajanı bul ve analiz yap (örneğin ID=30)
agent = mod.find_agent(30)

if agent:
    print(f"\nSeçilen Ajan Analizi:")
    print(f"Ajan ID: {agent.unique_id}")
    print(f"Pencere Boyutu: {agent.gecmis_veri_penceresi} gün")
    print(f"Piyasa Durumu: {agent.analyze_market()}")
else:
    print("Ajan bulunamadı!")
