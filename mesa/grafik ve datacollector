import matplotlib.pyplot as plt

agent_data = mod.datacollector.get_agent_vars_dataframe()
print(agent_data.head())  # Veriyi kontrol et

# Reset index to make 'AgentID' and 'Step' as columns
agent_data = agent_data.reset_index()

# Her bir ajanın T değerini zaman içinde çiz
plt.figure(figsize=(10, 6))
for agent_id in agent_data['AgentID'].unique():
    agent_df = agent_data[agent_data['AgentID'] == agent_id]
    # Check if 'T' column exists for the current agent
    if 'T' in agent_df.columns:
        plt.plot(agent_df['Step'], agent_df["T"], label=f"Ajan {agent_id}")

plt.xlabel("Adım")
plt.ylabel("T Değeri")
plt.title("TemelStrateji'de T Değişkeninin Zaman Serisi")
plt.legend()
plt.grid(True)
plt.show()

